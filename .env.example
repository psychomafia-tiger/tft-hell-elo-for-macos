# TFT Hell Elo — environment variables
# Copy this file to .env and fill in real values. .env is gitignored.

# Riot Games Developer API key
# Get from: https://developer.riotgames.com/ (login with Riot account)
# Dev tier: 100 req / 2 min, expires every 24h (must regenerate daily)
# Format: RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RIOT_API_KEY=

# Region for match fetching (TFT Set 17 anh play VN2)
# Other regions: NA1, EUW1, KR, JP1
RIOT_REGION=vn2

# Routing region for Match-v5 endpoint (regional, not platform)
# vn2 → sea | na1/br1 → americas | euw1/eun1/tr1/ru → europe | kr/jp1 → asia
RIOT_ROUTING=sea
